+/* Regression for recalled tasks stranded behind incompatible low-load workers. */
+#include "vine_worker_pool.h"
+#include "vine_worker_info.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+    struct vine_worker_pool *pool = vine_worker_pool_create();
+    struct vine_worker_info workers[4] = {{0}};
+    assert(pool);
+    for (int i = 0; i < 4; i++) {
+        workers[i].tasks_running = i; /* Target 3 is never the least loaded. */
+        assert(vine_worker_pool_offer(pool, &workers[i]));
+    }
+    /* Original repeated least-loaded selection hides target 3 indefinitely. */
+    for (int i = 0; i < 8; i++) {
+        struct vine_worker_info *w = vine_worker_pool_take_least_loaded(pool);
+        assert(w == &workers[0]);
+        assert(vine_worker_pool_offer(pool, w));
+    }
+    for (int pass = 0; pass < 3; pass++) {
+        unsigned seen = 0;
+        vine_worker_pool_begin_pass(pool);
+        for (int i = 0; i < 4; i++) {
+            struct vine_worker_info *w = vine_worker_pool_take_least_loaded_once(pool);
+            assert(w);
+            unsigned bit = 1U << (w - workers);
+            assert(!(seen & bit));
+            seen |= bit;
+            /* Compatibility failure leaves the worker reusable. */
+            assert(vine_worker_pool_offer(pool, w));
+        }
+        assert(seen == 15);
+        assert(!vine_worker_pool_take_least_loaded_once(pool));
+    }
+    /* Compact stale ring entries and survive slot reuse with a new generation. */
+    vine_worker_pool_remove(pool, &workers[1]);
+    vine_worker_pool_remove(pool, &workers[3]);
+    vine_worker_pool_begin_pass(pool);
+    assert(vine_worker_pool_ready(pool) == 2);
+    assert(vine_worker_pool_offer(pool, &workers[1]));
+    vine_worker_pool_begin_pass(pool);
+    unsigned seen = 0;
+    for (int i = 0; i < 3; i++) {
+        struct vine_worker_info *w = vine_worker_pool_take_least_loaded_once(pool);
+        assert(w && w != &workers[3]);
+        unsigned bit = 1U << (w - workers);
+        assert(!(seen & bit));
+        seen |= bit;
+    }
+    assert(seen == 7 && !vine_worker_pool_take_least_loaded_once(pool));
+    vine_worker_pool_delete(pool);
+    puts("PASS: bounded worker visits, destination reachability, stale generations");
+    return 0;
+}
