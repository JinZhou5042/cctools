{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctools.readthedocs.io/schemas/datavine.workflow.v1.json",
  "title": "DataVine Workflow IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "idempotency_key", "mode", "tasks", "data", "requested_outputs"],
  "properties": {
    "schema": {"const": "datavine.workflow/v1"},
    "workflow_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "mode": {"enum": ["sealed", "streaming", "staged"]},
    "task_defaults": {"$ref": "#/$defs/task_defaults"},
    "data_defaults": {"$ref": "#/$defs/data_defaults"},
    "tasks": {
      "type": "array",
      "items": {"oneOf": [
        {"$ref": "#/$defs/task"},
        {"$ref": "#/$defs/compact_task"}
      ]}
    },
    "data": {
      "type": "array",
      "items": {"oneOf": [
        {"$ref": "#/$defs/data"},
        {"$ref": "#/$defs/compact_data"}
      ]}
    },
    "requested_outputs": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true
    },
    "policy": {"$ref": "#/$defs/policy"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "base64"],
          "properties": {
            "kind": {"const": "inline"},
            "base64": {"type": "string", "maxLength": 1048576}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "uri"],
          "properties": {
            "kind": {"const": "uri"},
            "uri": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "task_id", "output_index"],
          "properties": {
            "kind": {"const": "output"},
            "task_id": {"type": "integer", "minimum": 1},
            "output_index": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id", "origin"],
      "properties": {
        "data_id": {"type": "integer", "minimum": 1},
        "codec": {"$ref": "#/$defs/codec"},
        "origin": {"$ref": "#/$defs/origin"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "compact_data": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id"],
      "properties": {
        "position": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "data_id": {"type": "integer", "minimum": 1}
      },
      "oneOf": [
        {"required": ["position"], "not": {"required": ["name"]}},
        {"required": ["name"], "not": {"required": ["position"]}}
      ]
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {"enum": ["command", "python", "taskvine"]},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "payload_ref": {"type": "integer", "minimum": 1},
        "function_ref": {"type": "integer", "minimum": 1},
        "function_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "maxLength": 1048576}
        },
        "output_files": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "working_directory": {"type": "string", "maxLength": 4096}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "command"}}},
          "then": {
            "required": ["argv"],
            "properties": {"version": {"const": "1"}}
          },
          "else": {"required": ["payload_ref"]}
        },
        {
          "if": {"properties": {"kind": {"const": "python"}}},
          "then": {
            "required": ["output_files"],
            "properties": {"version": {"enum": ["callable-v1", "source-v1"]}}
          },
          "else": {
            "if": {"properties": {"kind": {"const": "taskvine"}}},
            "then": {
              "properties": {"version": {"const": "builtin-v1"}},
              "not": {"required": ["output_files"]}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "python"},
              "version": {"const": "callable-v1"}
            },
            "required": ["kind", "version"]
          },
          "then": {"required": ["function_ref", "function_digest"]}
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cores": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 0},
        "disk_mb": {"type": "integer", "minimum": 0},
        "gpus": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_attempts"],
      "properties": {
        "maximum_attempts": {"type": "integer", "minimum": 1},
        "retryable_results": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 128},
          "uniqueItems": true
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "inputs", "output_data_ids"],
      "properties": {
        "task_id": {"type": "integer", "minimum": 1},
        "executor": {"$ref": "#/$defs/executor"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
        "output_data_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        },
        "resources": {"$ref": "#/$defs/resources"},
        "retry": {"$ref": "#/$defs/retry"},
        "priority": {"type": "integer"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "compact_task": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "array", "items": {"type": "integer", "minimum": 1}},
        {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "task_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executor": {"$ref": "#/$defs/executor"},
        "resources": {"$ref": "#/$defs/resources"},
        "retry": {"$ref": "#/$defs/retry"},
        "priority": {"type": "integer"}
      }
    },
    "data_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codec": {"$ref": "#/$defs/codec"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_tasks": {"type": "integer", "minimum": 1},
        "maximum_edges": {"type": "integer", "minimum": 0}
      }
    }
  }
}
