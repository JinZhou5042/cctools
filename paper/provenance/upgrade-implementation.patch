+#!/usr/bin/env python3
+"""An explicit unusable executor must fail before publishing service contact."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+
+def main():
+    executable = Path(__file__).resolve().parents[1] / 'src/tools/datavine_workflow'
+    with tempfile.TemporaryDirectory(prefix='datavine-override-') as directory:
+        root = Path(directory)
+        denied = root / 'not-executable'
+        denied.write_text('#!/bin/sh\nexit 0\n')
+        denied.chmod(0o600)
+        for variable in ['DATAVINE_EXECUTOR_PATH', 'DATAVINE_PYTHON_EXECUTOR_PATH']:
+            for target in [root / 'missing', denied]:
+                env = dict(os.environ)
+                env.pop('DATAVINE_EXECUTOR_PATH', None)
+                env.pop('DATAVINE_PYTHON_EXECUTOR_PATH', None)
+                env[variable] = str(target)
+                env['DATAVINE_RUNTIME_INFO_PATH'] = str(root / 'runtime')
+                done = subprocess.run([str(executable), 'serve', str(root / (variable + target.name)), 'test-token'],
+                                      env=env, cwd=root, capture_output=True, text=True, timeout=3)
+                assert done.returncode != 0, variable
+                assert '"endpoint"' not in done.stdout, done.stdout
+                assert 'configured executors' in done.stderr, done.stderr
+    print('PASS explicit executor overrides: missing and non-executable paths fail before contact', flush=True)
+
+
+if __name__ == '__main__':
+    main()
