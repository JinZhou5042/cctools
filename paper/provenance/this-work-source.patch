+#!/bin/sh
+set -eu
+case "${1:-run}" in
+prepare|clean) ;;
+run)
+    root=$(cd "$(dirname "$0")/../.." && pwd)
+    trial=$(mktemp -d "${TMPDIR:-/tmp}/datavine-worker-pool-XXXXXX")
+    trap 'rm -rf "$trial"' EXIT HUP INT TERM
+    ${CC:-cc} -std=gnu99 -Wall -Wextra -I"$root/taskvine/src/manager" \
+        -I"$root/taskvine/src" -I"$root/taskvine/src/worker" \
+        -I"$root/dttools/src" -I"$root" \
+        "$root/taskvine/test/datavine_worker_pool.c" \
+        "$root/taskvine/src/manager/vine_worker_pool.c" -o "$trial/test"
+    "$trial/test"
+    ;;
+*) exit 2 ;;
+esac
