+#!/usr/bin/env python3
+"""Disconnect while sending a later group member, then verify recovery."""
+from pathlib import Path
+import multiprocessing
+import selectors
+import socket
+import struct
+import subprocess
+import tempfile
+
+import ndcctools.taskvine as vine
+
+
+def payload_size(parent, payload):
+    return parent + len(payload) + 1
+
+
+def run():
+    root = Path(__file__).resolve().parents[2]
+    with tempfile.TemporaryDirectory(prefix='vine-group-disconnect-') as directory:
+        executor = vine.FuturesExecutor(port=0, factory=False)
+        manager = executor.manager
+        manager.tune('task-groups', 1)
+        manager.tune('worker-first-scheduling', 1)
+        manager.tune('function-start-timeout', 0)
+        manager.tune('transient-error-interval', 0)
+        debug = Path(directory) / 'manager.log'
+        vine.cvine.vine_enable_debug_log(str(debug))
+        library = manager.create_library_from_functions('group-reconnect', payload_size,
+                                                       add_env=False, exec_mode='fork')
+        library.set_cores(2)
+        library.set_function_slots(2)
+        manager.install_library(library)
+        first = executor.submit(executor.future_funcall('group-reconnect', 'payload_size', 0, b''))
+        # Larger than socket buffers: resetting in this payload makes the
+        # synchronous second commit fail after the first has succeeded.
+        payload = b'GROUP-DISCONNECT-MARKER-' * (1024 * 1024)
+        second = executor.submit(executor.future_funcall('group-reconnect', 'payload_size', first, payload))
+        listener = socket.socket()
+        listener.bind(('127.0.0.1', 0))
+        listener.listen()
+        listener.settimeout(.2)
+        context = multiprocessing.get_context('fork')
+        stopped = context.Event()
+        disconnected = context.Event()
+        errors = context.Queue()
+        manager_port = manager.port
+
+        def proxy():
+            while not stopped.is_set():
+                try:
+                    downstream, _ = listener.accept()
+                except socket.timeout:
+                    continue
+                upstream = socket.create_connection(('127.0.0.1', manager_port))
+                try:
+                    with selectors.DefaultSelector() as poll:
+                        poll.register(upstream, selectors.EVENT_READ, downstream)
+                        poll.register(downstream, selectors.EVENT_READ, upstream)
+                        active = True
+                        while active and not stopped.is_set():
+                            for key, _ in poll.select(.2):
+                                data = key.fileobj.recv(65536)
+                                if not data:
+                                    active = False
+                                    break
+                                if key.fileobj is upstream and not disconnected.is_set() and b'GROUP-DISCONNECT-MARKER-' * 8 in data:
+                                    disconnected.set()
+                                    upstream.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack('ii', 1, 0))
+                                    active = False
+                                    break
+                                key.data.sendall(data)
+                except (ConnectionError, OSError) as error:
+                    if not disconnected.is_set():
+                        errors.put(str(error))
+                finally:
+                    upstream.close()
+                    downstream.close()
+
+        # A separate process is necessary: a blocking C manager send may hold
+        # the Python GIL while the proxy must continue draining that socket.
+        proxy_process = context.Process(target=proxy, daemon=True)
+        proxy_process.start()
+        log = open(Path(directory) / 'worker.log', 'w')
+        worker = subprocess.Popen([str(root / 'taskvine/src/worker/vine_worker'),
+                                   '--cores', '2', '--memory', '1024', '--disk', '1024',
+                                   '--idle-timeout', '60', '127.0.0.1', str(listener.getsockname()[1])],
+                                  cwd=directory, stdout=log, stderr=log)
+        try:
+            assert second.result(timeout=60) == len(payload) + 2
+            assert disconnected.is_set(), 'fault was not injected'
+            assert errors.empty(), 'proxy failed before fault injection'
+            text = debug.read_text()
+            assert 'Failed to send task' in text, 'disconnect did not fail synchronous group commit'
+            manager._refresh_stats()
+            assert manager.stats.workers_removed >= 1
+        finally:
+            worker.terminate()
+            worker.wait(timeout=15)
+            stopped.set()
+            proxy_process.join(timeout=2)
+            if proxy_process.is_alive():
+                proxy_process.terminate()
+                proxy_process.join(timeout=2)
+            listener.close()
+            log.close()
+            manager.__del__()
+        print('PASS grouping: later-member send disconnect, worker reconnect, complete result', flush=True)
+
+
+if __name__ == '__main__':
+    run()
