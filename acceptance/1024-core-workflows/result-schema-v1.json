{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctools.example/datavine/1024-core-result-v1.schema.json",
  "title": "DataVine versus TaskVine fixed-core campaign result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_type", "schema_version", "status", "scope", "environment",
    "cases", "runs", "admission", "summary", "gates"
  ],
  "properties": {
    "artifact_type": {"const": "datavine-taskvine-1024-core-result"},
    "schema_version": {"const": 1},
    "status": {"enum": ["RUNNING", "PASS", "PILOT_PASS", "FAIL"]},
    "scope": {"enum": ["publication-1024-core", "nonpublication-validation"]},
    "environment": {
      "type": "object",
      "required": ["workers", "cores_per_worker", "total_cores", "batch_type"]
    },
    "cases": {"type": "array", "minItems": 1},
    "warmups": {"type": "array"},
    "runs": {"type": "array"},
    "admission": {"type": "object"},
    "summary": {"type": "array"},
    "gates": {"type": "object"}
  }
}
