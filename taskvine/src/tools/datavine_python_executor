#!/usr/bin/env python3
"""Single-threaded preloader and per-call fork executor for DataVine Python."""

import argparse
import array
import concurrent.futures
import hashlib
import json
import os
from collections import OrderedDict
from pathlib import Path
import select
import signal
import socket
import struct
import sys
import threading
import time

# Preload the serializer before forking. User source imports reuse these pages,
# while every child still has an independent interpreter and GIL.
import cloudpickle


FRAME_LIMIT = 64 * 1024 * 1024
SOURCE_TICKET = struct.Struct("!4sIQQ")
SOURCE_TICKET_V2 = struct.Struct("!4sIQQII32s")
CALLABLE_TICKET_V1 = struct.Struct("!4sIQII32s32s32s")
PERSIST_KEY_V1 = struct.Struct("!4s32sQI")
FUNCTION_CACHE_BYTES = 64 * 1024 * 1024
FUNCTION_CACHE_ENTRIES = 1024
MANIFEST_NAME = ".datavine-output-manifest"
PYTHON_TICKET_MAGIC = b"DVP1"
OUTPUT_MANIFEST_MAGIC = "DVM1"


class ObjectPuller:
    """Resolve immutable content keys from the worker-visible SharedFS store."""

    def __init__(self):
        root = os.environ.get("DATAVINE_OBJECT_ROOT")
        self.root = Path(root) if root else None

    def get_digest(self, digest):
        if self.root is None or len(digest) != 32:
            raise ValueError("invalid DataVine object key")
        encoded = digest.hex()
        value = (self.root / encoded[:2] / encoded[2:4] / encoded).read_bytes()
        if len(value) > FRAME_LIMIT or hashlib.sha256(value).digest() != digest:
            raise RuntimeError("DataVine SharedFS object digest mismatch")
        return value


def read_socket_exact(stream, size):
    chunks = []
    while size:
        chunk = stream.recv(size)
        if not chunk:
            raise ConnectionError("DataVine connection closed")
        chunks.append(chunk)
        size -= len(chunk)
    return b"".join(chunks)


class DurabilityNotifier:
    """One persistent Worker Data Agent connection for durable publications."""

    REQUEST = struct.Struct("!IHHIQ")
    RESPONSE = struct.Struct("!IHHIIQ")
    MAGIC = 0x44564331
    VERSION = 1
    AUTH = 1
    RESULT_PERSISTED = 35

    def __init__(self):
        self.lock = threading.Lock()
        self.stream = None
        self.endpoint = None
        self.token = None
        self.request_id = 0

    def close(self):
        if self.stream is not None:
            self.stream.close()
        self.stream = None
        self.endpoint = None
        self.token = None

    def exchange(self, opcode, payload):
        request_id = self.send_request(opcode, payload)
        self.read_response(opcode, request_id)

    def send_request(self, opcode, payload):
        self.request_id += 1
        request_id = self.request_id
        self.stream.sendall(self.REQUEST.pack(
            self.MAGIC, self.VERSION, opcode, len(payload), request_id,
        ) + payload)
        return request_id

    def read_response(self, opcode, request_id):
        header = read_socket_exact(self.stream, self.RESPONSE.size)
        magic, version, response_opcode, status, size, response_id = (
            self.RESPONSE.unpack(header)
        )
        if size:
            read_socket_exact(self.stream, size)
        if (
            magic != self.MAGIC or version != self.VERSION
            or response_opcode != opcode or response_id != request_id
            or status != 0
        ):
            raise RuntimeError("DataVine durability notification rejected")

    def connect(self, spec):
        endpoint = (spec["host"], spec["port"])
        if (
            self.stream is not None and self.endpoint == endpoint
            and self.token == spec["token"]
        ):
            return
        self.close()
        self.stream = socket.create_connection(endpoint, timeout=30)
        self.stream.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.endpoint = endpoint
        self.token = spec["token"]
        self.exchange(self.AUTH, self.token)

    def notify(self, spec, size, digest):
        path = spec["path"].encode("utf-8")
        if not path or len(path) > 65535:
            raise ValueError("invalid DataVine durable result path")
        payload = struct.pack("!HQ", len(path), size) + bytes.fromhex(digest) + path
        deadline = time.monotonic() + 30
        with self.lock:
            while True:
                try:
                    self.connect(spec)
                    # A durability notification is complete only after the
                    # Controller acknowledges it.  In particular, do not
                    # leave small batches write-only on a persistent socket:
                    # the peer may have expired an idle connection and a
                    # first write to that half-closed socket can appear to
                    # succeed while losing the notification.
                    self.exchange(self.RESULT_PERSISTED, payload)
                    return
                except (ConnectionError, OSError, RuntimeError):
                    self.close()
                    if time.monotonic() >= deadline:
                        raise
                    time.sleep(0.1)


def parse_persistence_context(value):
    fields = value.split("\n", 3)
    if len(fields) != 4:
        raise ValueError("invalid DataVine persistence context")
    host, port_text, token_hex, root = fields
    port = int(port_text)
    token = bytes.fromhex(token_hex)
    root = Path(root)
    if (
        not host or port < 1 or port > 65535 or not token
        or not root.is_absolute()
    ):
        raise ValueError("unsafe DataVine persistence context")
    return {"host": host, "port": port, "token": token, "root": root}


class HashingWriter:
    """Hash serialized bytes in the only write pass."""

    def __init__(self, stream):
        self.stream = stream
        self.digest = hashlib.sha256()
        self.size = 0

    def write(self, value):
        written = self.stream.write(value)
        if written is None:
            written = len(value)
        self.digest.update(memoryview(value)[:written])
        self.size += written
        return written

    def flush(self):
        return self.stream.flush()

    def fileno(self):
        return self.stream.fileno()


def write_manifest(
    entries, pull_ns, decode_ns, function_ns, serialize_ns, fsync_ns
):
    payload = "{}\n{}\n{}M {} {} {} {} {}\n".format(
        OUTPUT_MANIFEST_MAGIC,
        len(entries),
        "".join(f"{size} {digest}\n" for size, digest in entries),
        pull_ns,
        decode_ns,
        function_ns,
        serialize_ns,
        fsync_ns,
    ).encode("ascii")
    temporary = Path(MANIFEST_NAME + ".part")
    with temporary.open("wb") as stream:
        stream.write(payload)
    os.replace(temporary, MANIFEST_NAME)


def read_exact(fd, size):
    chunks = []
    while size:
        chunk = os.read(fd, size)
        if not chunk:
            raise EOFError("short invocation frame")
        chunks.append(chunk)
        size -= len(chunk)
    return b"".join(chunks)


def read_frame(fd):
    digits = bytearray()
    while len(digits) < 32:
        byte = os.read(fd, 1)
        if not byte:
            return None
        if byte == b"\n":
            break
        if byte < b"0" or byte > b"9":
            raise ValueError("invalid invocation length")
        digits.extend(byte)
    if not digits:
        raise ValueError("empty invocation length")
    size = int(digits)
    if size < 1 or size > FRAME_LIMIT:
        raise ValueError("invocation exceeds frame limit")
    frame = read_exact(fd, size)
    header, separator, payload = frame.partition(b"\n")
    if not separator:
        raise ValueError("invocation has no header terminator")
    fields = header.decode("utf-8").split(" ", 4)
    if len(fields) != 5:
        raise ValueError("invalid invocation header")
    invocation_id, function, sandbox, stdout_path, payload_size = fields
    if int(payload_size) != len(payload):
        raise ValueError("invocation payload length mismatch")
    return int(invocation_id), function, sandbox, stdout_path, payload


def send_frame(fd, payload):
    for part in (str(len(payload)).encode(), b"\n", payload):
        remaining = memoryview(part)
        while remaining:
            written = os.write(fd, remaining)
            if written < 1:
                raise OSError("short library frame write")
            remaining = remaining[written:]


def send_configuration(fd, task_id, worker_pid):
    body = json.dumps({
        "name": "datavine-python-v1",
        "taskid": task_id,
        "exec_mode": "fork",
    }, separators=(",", ":")).encode()
    send_frame(fd, body)
    os.kill(worker_pid, signal.SIGCHLD)


def send_result(fd, invocation_id, exit_code, worker_pid, payload=b""):
    header = f"{invocation_id} {exit_code} {len(payload)}\n".encode()
    send_frame(fd, header + payload)
    os.kill(worker_pid, signal.SIGCHLD)


def callable_main(
    data_root, invocation_bytes, function_bytes, retained_outputs,
    durable_outputs, output_overrides=None, pull_ns=0,
):
    payload = cloudpickle.loads(invocation_bytes)
    output_count = payload["output_count"]
    output_files = payload.get("output_files")
    if not isinstance(output_count, int) or output_count < 1:
        raise ValueError("Python invocation has invalid output count")
    if not isinstance(output_files, list) or len(output_files) != output_count:
        raise ValueError("Python invocation has invalid output files")
    if len(retained_outputs) != output_count or len(durable_outputs) != output_count:
        raise ValueError("Python invocation has invalid output policy")
    output_paths = []
    if output_overrides is None:
        output_overrides = [None] * output_count
    if len(output_overrides) != output_count:
        raise ValueError("Python invocation has invalid output overrides")
    for path, override, retained in zip(
        output_files, output_overrides, retained_outputs
    ):
        target = Path(path)
        if isinstance(override, dict):
            durable_target = Path(override["path"])
            if not durable_target.is_absolute() or not durable_target.name:
                raise ValueError("Python invocation SharedFS output path is unsafe")
        if target.is_absolute() or ".." in target.parts or target.name != str(target):
            raise ValueError("Python invocation output path is unsafe")
        # TaskVine requires every declared output to exist even when user code
        # fails or is killed. The controller publishes only successful tasks,
        # and successful serialization atomically replaces this placeholder.
        if retained:
            target.touch()
        output_paths.append(target if retained else None)

    def decode(value):
        kind, body = value
        if kind == "ref":
            with (data_root / str(body)).open("rb") as stream:
                return cloudpickle.load(stream)
        if kind == "tuple":
            return tuple(decode(item) for item in body)
        if kind == "list":
            return [decode(item) for item in body]
        if kind == "dict":
            return {decode(key): decode(item) for key, item in body}
        if kind == "pickle":
            return cloudpickle.loads(body)
        raise ValueError("unknown Python invocation value kind")

    decode_started = time.monotonic_ns()
    function = cloudpickle.loads(function_bytes)
    args = tuple(decode(value) for value in payload["args"])
    kwargs = {key: decode(value) for key, value in payload["kwargs"].items()}
    decode_ns = time.monotonic_ns() - decode_started
    function_started = time.monotonic_ns()
    result = function(*args, **kwargs)
    function_ns = time.monotonic_ns() - function_started
    outputs = tuple(result) if output_count != 1 else (result,)
    if len(outputs) != output_count:
        raise ValueError("Python callable returned the wrong output count")
    entries = []
    serialize_ns = 0
    fsync_ns = 0
    for target, value, durable in zip(output_paths, outputs, durable_outputs):
        if target is None:
            entries.append((0, "0" * 64))
            continue
        temporary = target.with_name(f"{target.name}.part-{os.getpid()}")
        with temporary.open("wb") as stream:
            writer = HashingWriter(stream)
            serialize_started = time.monotonic_ns()
            cloudpickle.dump(value, writer)
            serialize_ns += time.monotonic_ns() - serialize_started
            entries.append((writer.size, writer.digest.hexdigest()))
        os.replace(temporary, target)
    write_manifest(
        entries, pull_ns, decode_ns, function_ns, serialize_ns, fsync_ns
    )


def source_manifest(retained_outputs, function_ns):
    """Describe indexed source-v1 outputs without copying their payloads."""

    entries = []
    for index, retained in enumerate(retained_outputs):
        if not retained:
            entries.append((0, "0" * 64))
            continue
        path = Path(f"datavine-python-output-{index}")
        digest = hashlib.sha256()
        size = 0
        with path.open("rb") as stream:
            while True:
                block = stream.read(1024 * 1024)
                if not block:
                    break
                digest.update(block)
                size += len(block)
        entries.append((size, digest.hexdigest()))
    write_manifest(entries, 0, 0, function_ns, 0, 0)


def persist_one(source, spec, notifier):
    target = Path(spec["path"])
    temporary = target.with_name(
        f"{target.name}.part-persist-{os.getpid()}-{source}"
    )
    try:
        digest = hashlib.sha256()
        size = 0
        with temporary.open("wb") as output:
            while True:
                chunk = os.read(source, 1024 * 1024)
                if not chunk:
                    break
                output.write(chunk)
                digest.update(chunk)
                size += len(chunk)
            output.flush()
            os.fdatasync(output.fileno())
        os.replace(temporary, target)
        notifier.notify(spec, size, digest.hexdigest())
    finally:
        os.close(source)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def persistence_agent(stream, context):
    """Persistent Worker Data Agent; bytes never pass through the Manager."""
    notifier = DurabilityNotifier()
    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as writers:
        while True:
            message, ancillary, _, _ = stream.recvmsg(
                65536, socket.CMSG_SPACE(array.array("i").itemsize)
            )
            if not message:
                break
            descriptors = array.array("i")
            for level, kind, data in ancillary:
                if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                    descriptors.frombytes(
                        data[: len(data) - len(data) % descriptors.itemsize]
                    )
            if len(descriptors) != 1:
                for descriptor in descriptors:
                    os.close(descriptor)
                continue
            try:
                magic, workflow_key, data_id, attempt = (
                    PERSIST_KEY_V1.unpack(message)
                )
                if magic != b"DVE1" or data_id < 1 or attempt < 1:
                    raise ValueError("invalid DataVine eData key")
                path = (
                    context["root"] / workflow_key.hex()
                    / f"{data_id}.{attempt}.data"
                )
                spec = {
                    "host": context["host"], "port": context["port"],
                    "token": context["token"], "path": str(path),
                }
            except (ValueError, struct.error):
                os.close(descriptors[0])
                continue
            writers.submit(persist_one, descriptors[0], spec, notifier)
    notifier.close()


def start_persistence(stream, sandbox, output_overrides):
    """Queue lazy writes after opening local outputs, then report completion."""
    for index, target in enumerate(output_overrides or ()):
        if not target:
            continue
        source = -1
        try:
            source = os.open(
                str(Path(sandbox) / f"datavine-python-output-{index}"),
                os.O_RDONLY | os.O_CLOEXEC,
            )
            descriptors = array.array("i", [source])
            stream.sendmsg(
                [target],
                [(socket.SOL_SOCKET, socket.SCM_RIGHTS, descriptors)],
            )
            os.close(source)
        except OSError:
            if source >= 0:
                try:
                    os.close(source)
                except OSError:
                    pass
            return False
    return True


def child_main(
    sandbox, stdout_path, payload_id, inherited_fds, function_bytes=None,
    invocation_bytes=None, retained_outputs=None, durable_outputs=None,
    output_overrides=None, pull_ns=0,
):
    exit_code = 1
    try:
        signal.signal(signal.SIGCHLD, signal.SIG_DFL)
        os.setsid()
        for fd in inherited_fds:
            try:
                os.close(fd)
            except OSError:
                pass
        os.chdir(sandbox)
        output = os.open(stdout_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.dup2(output, sys.stdout.fileno())
        os.dup2(output, sys.stderr.fileno())
        os.close(output)
        data_root = Path("datavine/data")
        if data_root.is_dir():
            for item in data_root.iterdir():
                if item.name.isdigit():
                    os.environ[f"DATAVINE_DATA_{item.name}"] = str(item)
        if function_bytes is None:
            source_path = data_root / str(payload_id)
            source = source_path.read_text(encoding="utf-8")
            namespace = {"__name__": "__main__", "__file__": str(source_path)}
            function_started = time.monotonic_ns()
            exec(compile(source, str(source_path), "exec"), namespace, namespace)
            function_ns = time.monotonic_ns() - function_started
            if retained_outputs is not None:
                source_manifest(retained_outputs, function_ns)
        else:
            callable_main(
                data_root, invocation_bytes, function_bytes,
                retained_outputs, durable_outputs, output_overrides, pull_ns,
            )
        exit_code = 0
    except BaseException:
        import traceback

        traceback.print_exc()
    finally:
        try:
            sys.stdout.flush()
            sys.stderr.flush()
        except BaseException:
            exit_code = exit_code or 1
        os._exit(exit_code)


def exit_code(status):
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--in-pipe-fd", type=int, required=True)
    parser.add_argument("--out-pipe-fd", type=int, required=True)
    parser.add_argument("--task-id", type=int, required=True)
    parser.add_argument("--worker-pid", type=int, required=True)
    parser.add_argument("--library-cores", type=int, default=0)
    parser.add_argument("--function-slots", type=int, default=1)
    args = parser.parse_args()
    if args.task_id < 1 or args.worker_pid < 1 or args.function_slots < 1:
        return 2
    try:
        persistence_context = parse_persistence_context(
            os.environ["DATAVINE_PERSIST_CONTEXT_V1"]
        )
    except (KeyError, ValueError):
        return 2

    notify_read, notify_write = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)

    def child_ready(signum, frame):
        del signum, frame
        try:
            os.write(notify_write, b"x")
        except BlockingIOError:
            pass

    signal.signal(signal.SIGCHLD, child_ready)
    send_configuration(args.out_pipe_fd, args.task_id, args.worker_pid)
    persistence_stream, agent_stream = socket.socketpair(
        socket.AF_UNIX, socket.SOCK_SEQPACKET
    )
    persistence_agent_pid = os.fork()
    if persistence_agent_pid == 0:
        persistence_stream.close()
        for descriptor in (
            args.in_pipe_fd, args.out_pipe_fd, notify_read, notify_write
        ):
            try:
                os.close(descriptor)
            except OSError:
                pass
        try:
            persistence_agent(agent_stream, persistence_context)
        finally:
            agent_stream.close()
        os._exit(0)
    agent_stream.close()
    parent_pid = os.getppid()
    children = {}
    functions = OrderedDict()
    function_cache_bytes = 0
    object_puller = ObjectPuller()
    state = {"stopping": False}

    def stop(signum, frame):
        del signum, frame
        state["stopping"] = True

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    while not state["stopping"]:
        if os.getppid() != parent_pid or parent_pid == 1:
            break
        readable, _, _ = select.select(
            (args.in_pipe_fd, notify_read), (), (), 1.0
        )
        if args.in_pipe_fd in readable:
            invocation = read_frame(args.in_pipe_fd)
            if invocation is None:
                return 0
            invocation_id, function, sandbox, stdout_path, payload = invocation
            payload_id = 0
            function_id = 0
            function_bytes = None
            invocation_bytes = None
            invocation_digest = None
            pull_ns = 0
            retained_outputs = None
            durable_outputs = None
            output_overrides = None
            valid = False
            if function == "datavine_python_source" and len(payload) == SOURCE_TICKET.size:
                magic, reserved, payload_id, wall_seconds = SOURCE_TICKET.unpack(payload)
                valid = magic == PYTHON_TICKET_MAGIC and reserved == 0 and payload_id > 0
            elif (
                function == "datavine_python_source"
                and len(payload) >= SOURCE_TICKET_V2.size
            ):
                (
                    magic, reserved, payload_id, wall_seconds, output_count,
                    attempt, workflow_key,
                ) = SOURCE_TICKET_V2.unpack(payload[:SOURCE_TICKET_V2.size])
                policy_end = SOURCE_TICKET_V2.size + output_count * 2
                ids_end = policy_end + output_count * 8
                valid = (
                    magic == PYTHON_TICKET_MAGIC and reserved == 0
                    and payload_id > 0 and output_count > 0 and attempt > 0
                    and ids_end == len(payload)
                )
                if valid:
                    retained_outputs = payload[
                        SOURCE_TICKET_V2.size:
                        SOURCE_TICKET_V2.size + output_count
                    ]
                    durable_outputs = payload[
                        SOURCE_TICKET_V2.size + output_count:policy_end
                    ]
                    output_overrides = []
                    for index in range(output_count):
                        data_id = struct.unpack_from(
                            "!Q", payload, policy_end + index * 8
                        )[0]
                        valid = valid and data_id > 0
                        output_overrides.append(
                            PERSIST_KEY_V1.pack(
                                b"DVE1", workflow_key, data_id, attempt
                            ) if durable_outputs[index] else None
                        )
            elif (
                function == "datavine_python_callable"
                and len(payload) >= 4
            ):
                magic = payload[:4]
                if magic == PYTHON_TICKET_MAGIC and len(payload) >= CALLABLE_TICKET_V1.size:
                    (
                        magic, reserved, wall_seconds, output_count, attempt,
                        workflow_key, invocation_digest, function_digest,
                    ) = CALLABLE_TICKET_V1.unpack(
                        payload[:CALLABLE_TICKET_V1.size]
                    )
                    policy_end = CALLABLE_TICKET_V1.size + output_count * 2
                    ids_end = policy_end + output_count * 8
                    valid = (
                        reserved == 0 and output_count > 0 and attempt > 0
                        and ids_end == len(payload)
                    )
                    if valid:
                        retained_outputs = payload[
                            CALLABLE_TICKET_V1.size:
                            CALLABLE_TICKET_V1.size + output_count
                        ]
                        durable_outputs = payload[
                            CALLABLE_TICKET_V1.size + output_count:policy_end
                        ]
                        output_overrides = []
                        for index in range(output_count):
                            data_id = struct.unpack_from(
                                "!Q", payload, policy_end + index * 8
                            )[0]
                            valid = valid and data_id > 0
                            output_overrides.append(
                                PERSIST_KEY_V1.pack(
                                    b"DVE1", workflow_key, data_id, attempt
                                ) if durable_outputs[index] else None
                            )
                if valid:
                    try:
                        pull_started = time.monotonic_ns()
                        invocation_bytes = object_puller.get_digest(
                            invocation_digest
                        )
                        pull_ns += time.monotonic_ns() - pull_started
                    except (OSError, ValueError, RuntimeError):
                        valid = False
                    if valid and (
                        not invocation_bytes or len(invocation_bytes) > FRAME_LIMIT
                    ):
                        valid = False
                if valid:
                    function_bytes = functions.pop(function_digest, None)
                    if function_bytes is None:
                        try:
                            pull_started = time.monotonic_ns()
                            function_bytes = object_puller.get_digest(
                                function_digest
                            )
                            pull_ns += time.monotonic_ns() - pull_started
                        except (OSError, ValueError, RuntimeError):
                            valid = False
                        if valid and (
                            len(function_bytes) > FUNCTION_CACHE_BYTES
                            or hashlib.sha256(function_bytes).digest()
                            != function_digest
                        ):
                            valid = False
                        if valid:
                            while functions and (
                                len(functions) >= FUNCTION_CACHE_ENTRIES
                                or function_cache_bytes + len(function_bytes)
                                > FUNCTION_CACHE_BYTES
                            ):
                                _, evicted = functions.popitem(last=False)
                                function_cache_bytes -= len(evicted)
                            functions[function_digest] = function_bytes
                            function_cache_bytes += len(function_bytes)
                    else:
                        functions[function_digest] = function_bytes
            if not valid:
                send_result(args.out_pipe_fd, invocation_id, 2, args.worker_pid)
                continue
            try:
                pid = os.fork()
            except OSError:
                pid = -1
            if pid == 0:
                child_main(
                    sandbox, stdout_path, payload_id,
                    (args.in_pipe_fd, args.out_pipe_fd, notify_read, notify_write,
                     persistence_stream.fileno()),
                    function_bytes,
                    invocation_bytes,
                    retained_outputs,
                    durable_outputs,
                    output_overrides,
                    pull_ns,
                )
            if pid < 0:
                send_result(args.out_pipe_fd, invocation_id, 3, args.worker_pid)
                continue
            children[pid] = {
                "invocation_id": invocation_id,
                "deadline": time.monotonic() + wall_seconds if wall_seconds else None,
                "sandbox": sandbox,
                "stdout": str(Path(sandbox) / stdout_path),
                "manifest": str(Path(sandbox) / MANIFEST_NAME),
                "manifest_output": retained_outputs is not None,
                "timed_out": False,
                "cancelled": False,
                "output_overrides": output_overrides,
            }
        if notify_read in readable:
            try:
                while os.read(notify_read, 4096):
                    pass
            except BlockingIOError:
                pass
        now = time.monotonic()
        for pid, child in list(children.items()):
            if not child["cancelled"] and not Path(child["sandbox"]).is_dir():
                child["cancelled"] = True
                try:
                    os.killpg(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            if child["deadline"] and now >= child["deadline"] and not child["timed_out"]:
                child["timed_out"] = True
                try:
                    os.killpg(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        while children:
            pid, status = os.waitpid(-1, os.WNOHANG)
            if pid <= 0:
                break
            child = children.pop(pid, None)
            if child:
                if child["cancelled"]:
                    continue
                code = 124 if child["timed_out"] else exit_code(status)
                try:
                    payload_path = (
                        child["manifest"]
                        if code == 0 and child["manifest_output"]
                        else child["stdout"]
                    )
                    payload = Path(payload_path).read_bytes()
                except OSError:
                    payload = b""
                    code = code or 1
                if len(payload) > FRAME_LIMIT:
                    payload = b"DataVine Python output exceeds 64 MiB"
                    code = 125
                if code == 0 and child["manifest_output"]:
                    if not start_persistence(
                        persistence_stream,
                        child["sandbox"], child["output_overrides"]
                    ):
                        code = 1
                send_result(
                    args.out_pipe_fd, child["invocation_id"], code,
                    args.worker_pid, payload,
                )
    for pid in children:
        try:
            os.killpg(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    while children:
        try:
            pid, _ = os.waitpid(-1, 0)
        except ChildProcessError:
            break
        children.pop(pid, None)
    persistence_stream.close()
    try:
        os.waitpid(persistence_agent_pid, 0)
    except ChildProcessError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
