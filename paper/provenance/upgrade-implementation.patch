+#!/usr/bin/env python3
+"""Native grouping must retain calls deferred by library startup or credits."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+import ndcctools.taskvine as vine
+
+
+def add(*values):
+    return sum(values)+1
+
+
+def slow_add(*values):
+    import time
+    time.sleep(.05)
+    return sum(values)+1
+
+
+def run(cores, start_timeout=None):
+    root=Path(__file__).resolve().parents[2]
+    with tempfile.TemporaryDirectory(prefix='vine-group-credit-') as directory:
+        executor=vine.FuturesExecutor(port=0,factory=False)
+        manager=executor.manager
+        assert manager.tune('task-groups',1)==0
+        function = add if start_timeout is None else slow_add
+        if start_timeout is not None:
+            assert manager.tune('function-start-timeout', start_timeout)==0
+        library=manager.create_library_from_functions('group-add',function,add_env=False,exec_mode='fork')
+        library.set_cores(cores)
+        library.set_function_slots(cores)
+        manager.install_library(library)
+        chains=[]
+        for seed in range(8):
+            parent=seed
+            for _ in range(4):
+                task=executor.future_funcall('group-add',function.__name__,parent)
+                task.set_cores(1)
+                parent=executor.submit(task)
+            chains.append(parent)
+        # Cross-group fan-in must not be sent as part of only one input chain.
+        join=executor.submit(executor.future_funcall('group-add',function.__name__,*chains))
+        sink=executor.submit(executor.future_funcall('group-add',function.__name__,join))
+        with open(Path(directory)/'worker.log','w') as log:
+            worker=subprocess.Popen([str(root/'taskvine/src/worker/vine_worker'),
+                '--cores',str(cores),'--memory','1024','--disk','1024','--idle-timeout','60',
+                'localhost',str(manager.port)],cwd=directory,stdout=log,stderr=log)
+            try:
+                assert sink.result(timeout=45)==sum(range(8))+8*4+2
+                assert [future.result(timeout=5) for future in chains]==[i+4 for i in range(8)]
+                manager._refresh_stats()
+                assert manager.stats.tasks_done==34
+                assert manager.stats.tasks_failed==0
+            finally:
+                worker.terminate()
+                worker.wait(timeout=15)
+                manager.__del__()
+    print(f'PASS grouping: {cores} credits, cold library, 8 chains, cross-group join, start timeout {start_timeout}',flush=True)
+
+
+def cancel():
+    executor=vine.FuturesExecutor(port=0,factory=False)
+    manager=executor.manager
+    manager.tune('task-groups',1)
+    library=manager.create_library_from_functions('not-installed',add,add_env=False,exec_mode='fork')
+    library.set_cores(1)
+    library.set_function_slots(1)
+    manager.install_library(library)
+    parent=executor.submit(executor.future_funcall('not-installed','add',0))
+    child=executor.submit(executor.future_funcall('not-installed','add',parent))
+    assert manager.cancel_by_task_id(child._task.id)
+    manager.__del__()
+    print('PASS grouping: cancel and destroy uncommitted group',flush=True)
+
+
+if __name__=='__main__':
+    for capacity in [1,4]:run(capacity)
+    run(4, start_timeout=.01)
+    cancel()
